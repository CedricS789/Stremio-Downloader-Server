# =====================================================================
# My-Media-Dock Environment Configuration
# =====================================================================

# Media library root mount path inside WSL (e.g. /mnt/c/StremioMedia or /mnt/d/Media)
# The directory must contain 'media/movies' and 'media/tv' subdirectories.
MEDIA_ROOT=/mnt/c/StremioMedia

# Admin dashboard credentials (change to your own secure random strings)
NUVI_ADMIN_PASSWORD=change_this_to_a_random_secure_password
NUVI_SESSION_SECRET=change_this_to_a_random_32_byte_hex_string
NUVI_STREAM_SECRET=change_this_to_a_random_32_byte_hex_string

# (Optional) Configured AIOStreams addon URL without the trailing /manifest.json
# Example: https://aiostreams.example.com/your-private-uuid
# AIOSTREAMS_BASE_URL=
